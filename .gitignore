# Signing secrets. Losing the keystore means you can never ship an update to an
# already-published app, so keep a backup somewhere safe — just not in git.
*.jks
*.keystore
keystore.properties

# OS junk
.DS_Store
Thumbs.db

# Local-only: .claude/ holds editor/preview config that points at paths on this
# machine, and .debug/ holds ad-hoc screenshots and test clips (some of them
# personal video files). Neither belongs in the repository.
.claude/
.debug/
.omc-*
.workbuddy/
